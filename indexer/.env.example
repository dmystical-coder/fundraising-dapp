# Postgres connection string (Neon, local, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fundraising

# Optional: if set, only accept/parse prints from this contract
EXPECTED_CONTRACT_IDENTIFIER=SP3R3SX667CWE61113X23CAQ03SZXXZ3D8D3A4NFH.fundraising

# Hiro Chainhooks API registration
CHAINHOOKS_NETWORK=mainnet
CHAINHOOKS_API_KEY=replace-me

# Where Hiro will POST events (your Next.js frontend /api/chainhook route)
CHAINHOOKS_WEBHOOK_URL=https://your-frontend-domain.com/api/chainhook

# Optional: chainhook name (used for replace behavior)
# CHAINHOOKS_NAME=Fundraising contract logs

# Optional: if true, deletes an existing chainhook with the same name+network first
# CHAINHOOKS_REPLACE_EXISTING=true
