# Network configuration (devnet | testnet | mainnet)
NEXT_PUBLIC_STACKS_NETWORK=devnet

# "platform" when running devnet in Hiro platform, "local" when running devnet locally
NEXT_PUBLIC_DEVNET_HOST=platform

NEXT_PUBLIC_PLATFORM_HIRO_API_KEY=XXXX

NEXT_PUBLIC_CONTRACT_DEPLOYER_TESTNET_ADDRESS=XXXX
NEXT_PUBLIC_CONTRACT_DEPLOYER_MAINNET_ADDRESS=SP3R3SX667CWE61113X23CAQ03SZXXZ3D8D3A4NFH

# Database (server-side only, used by Next.js API routes)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: only parse print events from this contract
EXPECTED_CONTRACT_IDENTIFIER=SP3R3SX667CWE61113X23CAQ03SZXXZ3D8D3A4NFH.fundraising

# Optional: require Bearer token on POST /api/chainhook
# Note: Hiro Chainhooks API cannot send custom headers, so leave unset for production
# CHAINHOOK_AUTH_TOKEN=
